<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ryzn_sheet_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/add_server_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:maxLines="1"
        android:text="Tambah Server"
        android:textColor="@color/manga_ink"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:text="Masukkan alamat IP atau domain beserta port"
        android:textColor="@color/ryzn_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/address_input_text"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/ryzn_field_surface"
        android:fontFamily="@font/montserrat_medium"
        android:hint="contoh: 127.0.0.1:7777"
        android:imeOptions="actionDone"
        android:inputType="textUri|textNoSuggestions"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/manga_ink"
        android:textColorHint="@color/ryzn_text_muted"
        android:textSize="13sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/add_server"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_btn_play_purple"
        android:drawableStart="@drawable/ic_add"
        android:drawablePadding="8dp"
        android:fontFamily="@font/montserrat_bold"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="3dp"
        android:text="Simpan ke Daftar"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

</LinearLayout>
