<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp">

        <TextView
            android:id="@+id/Settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_section_header_tab"
            android:fontFamily="@font/montserrat_bold"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/nav_settings"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Sesuaikan Nick_Name, tampilan, dan data game"
            android:textColor="@color/ryzn_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="14dp">

            <!-- Section: Profil Pemain -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="4dp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.08"
                android:text="PROFIL PEMAIN"
                android:textColor="@color/manga_crimson"
                android:textSize="9.5sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="9dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="5dp"
                    android:src="@drawable/ic_nick"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <EditText
                    android:id="@+id/settings_nick_input"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/ryzn_field_surface"
                    android:fontFamily="@font/montserrat_medium"
                    android:hint="Nick_Name..."
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:maxLength="24"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:textColor="@color/manga_ink"
                    android:textColorHint="@color/ryzn_text_muted"
                    android:textSize="11.5sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/settings_nick_save"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_btn_play_purple"
                    android:fontFamily="@font/montserrat_bold"
                    android:minWidth="64dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="2dp"
                    android:text="Simpan"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#CBD3E1" />

            <!-- Section: Tampilan & Layar -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.08"
                android:text="TAMPILAN &amp; LAYAR"
                android:textColor="@color/manga_crimson"
                android:textSize="9.5sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/displayfpsIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/displayfpsIcon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Tampilkan FPS"
                        android:textColor="@color/manga_ink"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular"
                        android:text="Teks FPS putih minimalis di pojok"
                        android:textColor="@color/ryzn_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/displayfps_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleX="0.88"
                    android:scaleY="0.88"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/ryzn_switch_track"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/fullscreenmodeIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/fullscreenmodeIcon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Mode Layar Penuh"
                        android:textColor="@color/manga_ink"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular"
                        android:text="Isi penuh layar hingga area notch"
                        android:textColor="@color/ryzn_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/fullscreen_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleX="0.88"
                    android:scaleY="0.88"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/ryzn_switch_track"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/radarrectIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/radarrectIcon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Radar Kotak"
                        android:textColor="@color/manga_ink"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular"
                        android:text="Ubah bentuk minimap menjadi kotak"
                        android:textColor="@color/ryzn_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/radarrect_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleX="0.88"
                    android:scaleY="0.88"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/ryzn_switch_track"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="#CBD3E1" />

            <!-- Section: Suara & Chat -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.08"
                android:text="SUARA &amp; OBROLAN"
                android:textColor="@color/manga_crimson"
                android:textSize="9.5sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/voicechatIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/voicechatIcon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Voice Chat"
                        android:textColor="@color/manga_ink"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular"
                        android:text="Tombol mikrofon saat berada di game"
                        android:textColor="@color/ryzn_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/voice_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleX="0.88"
                    android:scaleY="0.88"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/ryzn_switch_track"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/chattimestampIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/chattimestampIcon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Timestamp Obrolan"
                        android:textColor="@color/manga_ink"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular"
                        android:text="Tampilkan jam di awal pesan chat"
                        android:textColor="@color/ryzn_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/timestamp_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleX="0.88"
                    android:scaleY="0.88"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/ryzn_switch_track"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/fontsizeIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/fontsizeIcon"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Ukuran Font"
                    android:textColor="@color/manga_ink"
                    android:textSize="11.5sp" />

                <EditText
                    android:id="@+id/fontsize"
                    android:layout_width="64dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_stepper_bg"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:hint="30.0"
                    android:inputType="numberDecimal"
                    android:maxLength="5"
                    android:singleLine="true"
                    android:textColor="@color/manga_ink"
                    android:textColorHint="@color/ryzn_text_muted"
                    android:textSize="11sp" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/chatstringsIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/chatstringsIcon"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Baris Obrolan"
                    android:textColor="@color/manga_ink"
                    android:textSize="11.5sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_stepper_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/chat_minus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/montserrat_bold"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="-"
                        android:textColor="@color/manga_crimson"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/chat_strings"
                        android:layout_width="24dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:gravity="center"
                        android:text="8"
                        android:textColor="@color/manga_ink"
                        android:textSize="11sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/chat_plus"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/montserrat_bold"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="+"
                        android:textColor="@color/manga_crimson"
                        android:textSize="14sp" />
                </LinearLayout>
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="#CBD3E1" />

            <!-- Section: Sistem & Data -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.08"
                android:text="SISTEM &amp; DATA"
                android:textColor="@color/manga_crimson"
                android:textSize="9.5sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/modifiedDataIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toStartOf="@id/modifieddata_switch"
                    android:layout_toEndOf="@id/modifiedDataIcon"
                    android:paddingEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Modified Data"
                        android:textColor="@color/manga_ink"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/montserrat_regular"
                        android:maxLines="1"
                        android:text="Baca modpack / data lokal tanpa timpa"
                        android:textColor="@color/ryzn_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/modifieddata_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:scaleX="0.88"
                    android:scaleY="0.88"
                    android:thumb="@drawable/ic_thumb"
                    android:track="@drawable/ryzn_switch_track"
                    tools:ignore="UseSwitchCompatOrMaterialXml" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/gameDataIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/gameDataIcon"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Data Game"
                        android:textColor="@color/manga_ink"
                        android:textSize="11.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_regular"
                        android:text="Simpanan /ryznSAMP/"
                        android:textColor="@color/ryzn_text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/reinstallGame"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_btn_play_purple"
                    android:fontFamily="@font/montserrat_bold"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="1dp"
                    android:text="Unduh / Perbaiki"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="44dp">

                <ImageView
                    android:id="@+id/resetIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/ryzn_icon_tint_circle"
                    android:padding="6dp"
                    android:src="@drawable/security_icon"
                    app:tint="@color/manga_ink"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/resetText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/resetIcon"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Reset Pengaturan"
                    android:textColor="@color/manga_ink"
                    android:textSize="11.5sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/restore_button"
                    android:layout_width="76dp"
                    android:layout_height="30dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_btn_action_dark"
                    android:fontFamily="@font/montserrat_bold"
                    android:paddingBottom="1dp"
                    android:text="Reset"
                    android:textAllCaps="false"
                    android:textColor="@color/manga_ink"
                    android:textSize="10sp" />
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
