<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ryzn_sheet_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/prompt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:text="Identitas Pemain"
        android:textColor="@color/manga_ink"
        android:textSize="14.5sp" />

    <TextView
        android:id="@+id/prompt_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/roboto_regular"
        android:gravity="center"
        android:maxLines="2"
        android:text="Masukkan Nick_Name (tanpa spasi, maks 24 huruf)"
        android:textColor="@color/ryzn_text_secondary"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/prompt_nickname_input"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/ryzn_field_surface"
        android:fontFamily="@font/roboto_medium"
        android:hint="Nick_Name..."
        android:imeOptions="actionDone"
        android:inputType="textNoSuggestions"
        android:maxLength="24"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/manga_ink"
        android:textColorHint="@color/ryzn_text_muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/prompt_password_input"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ryzn_field_surface"
        android:fontFamily="@font/roboto_medium"
        android:hint="Kata sandi server..."
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/manga_ink"
        android:textColorHint="@color/ryzn_text_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/prompt_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_action_dark"
            android:fontFamily="@font/montserrat_bold"
            android:paddingBottom="1dp"
            android:text="Batal"
            android:textAllCaps="false"
            android:textColor="@color/manga_ink"
            android:textSize="12sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/prompt_confirm_btn"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_play_purple"
            android:fontFamily="@font/montserrat_bold"
            android:paddingBottom="2dp"
            android:text="Simpan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
