<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ryzn_sheet_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/prompt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:text="Identitas Pemain"
        android:textColor="@color/ryzn_text_primary"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/prompt_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:ellipsize="end"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:maxLines="2"
        android:text="Masukkan Nick_Name (tanpa spasi, maks 24 huruf)"
        android:textColor="@color/ryzn_text_secondary"
        android:textSize="11.5sp" />

    <EditText
        android:id="@+id/prompt_nickname_input"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/ryzn_field_surface"
        android:fontFamily="@font/montserrat_regular"
        android:hint="Nick_Name..."
        android:imeOptions="actionDone"
        android:inputType="textNoSuggestions"
        android:maxLength="24"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/ryzn_text_primary"
        android:textColorHint="@color/ryzn_text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/prompt_password_input"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/ryzn_field_surface"
        android:fontFamily="@font/montserrat_regular"
        android:hint="Kata sandi server..."
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="@color/ryzn_text_primary"
        android:textColorHint="@color/ryzn_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/prompt_cancel_btn"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_action_dark"
            android:fontFamily="@font/montserrat_bold"
            android:text="Batal"
            android:textAllCaps="false"
            android:textColor="@color/ryzn_text_primary"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/prompt_confirm_btn"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_play_purple"
            android:fontFamily="@font/montserrat_bold"
            android:text="Simpan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
