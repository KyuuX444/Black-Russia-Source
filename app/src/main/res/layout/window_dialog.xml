<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/alyn_samp_border"
    android:orientation="vertical"
    android:paddingTop="14dp"
    android:paddingBottom="14dp"
    android:visibility="visible">

    <TextView
        android:id="@+id/dw_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:text="Judul Dialog"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dw_scroll_info"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="18dp"
        android:layout_weight="0.5"
        android:overScrollMode="never"
        android:scrollbarThumbHorizontal="@android:color/transparent"
        android:scrollbarThumbVertical="@android:color/transparent"
        android:scrollbarTrackHorizontal="@android:color/transparent"
        android:scrollbarTrackVertical="@android:color/transparent"
        android:visibility="gone">

        <TextView
            android:id="@+id/dw_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:lineSpacingExtra="3sp"
            android:text="Info"
            android:textColor="#A9C4E4"
            android:textSize="12sp" />
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/dw_scroll_root"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="12dp"
        android:layout_weight="0.5"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/dw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="18dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:fontFamily="sans-serif-medium"
                android:text="Kolom 1"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:fontFamily="sans-serif-medium"
                android:text="Kolom 2"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.25"
                android:fontFamily="sans-serif-medium"
                android:text="Kolom 3"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginRight="18dp"
                android:layout_weight="0.25"
                android:fontFamily="sans-serif-medium"
                android:text="Kolom 4"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/dw_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="18dp"
            android:layout_marginBottom="10dp"
            android:background="#669ECAFF"
            android:visibility="visible" />

        <ScrollView
            android:id="@+id/dw_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadeScrollbars="false"
            android:scrollbarAlwaysDrawVerticalTrack="true"
            android:scrollbarStyle="outsideInset"
            android:scrollbarThumbVertical="@drawable/br_dialog_scroll_thumb"
            android:scrollbarTrackVertical="@drawable/br_dialog_scroll_track">

            <LinearLayout
                android:id="@+id/dw_scroll_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:scrollbarStyle="insideOverlay">

                <TextView
                    android:id="@+id/dw_list_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/alyn_list_inactive"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="start|center_vertical"
                    android:paddingLeft="12dp"
                    android:paddingTop="7dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="7dp"
                    android:text="Item"
                    android:textAllCaps="false"
                    android:textColor="#A9C4E4"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.nvidia.devtech.CustomEditText
        android:id="@+id/dw_edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="18dp"
        android:background="@drawable/alyn_input_bg"
        android:ems="10"
        android:fontFamily="sans-serif"
        android:gravity="start"
        android:hint="Ketuk untuk mengetik"
        android:imeOptions="actionSend|flagNoFullscreen|flagNoExtractUi"
        android:inputType="text"
        android:longClickable="true"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:textColor="#FFFFFF"
        android:textColorHint="#8A8A8A"
        android:textSize="13sp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/dw_root_buttons"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginLeft="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/dw_button_ok"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/alyn_btn_primary"
            android:fontFamily="sans-serif-medium"
            android:minWidth="96dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="OK"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/dw_button_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:background="@drawable/alyn_btn_secondary"
            android:fontFamily="sans-serif-medium"
            android:minWidth="96dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="Batal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
