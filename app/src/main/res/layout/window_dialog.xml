<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/ryzn_pc_dialog_bg"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dialog_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="460.0px"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="840.0px"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/dialog_caption_bg"
                android:layout_width="0.0dip"
                android:layout_height="0.0dip"
                android:layout_marginStart="2.0px"
                android:layout_marginTop="2.0px"
                android:layout_marginEnd="2.0px"
                android:background="#55000000"
                app:layout_constraintBottom_toBottomOf="@+id/dialog_caption"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/dialog_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arial_bold"
                android:gravity="start|center_vertical"
                android:lines="1"
                android:maxLines="1"
                android:paddingStart="18.0px"
                android:paddingTop="10.0px"
                android:paddingEnd="24.0px"
                android:paddingBottom="10.0px"
                android:shadowColor="#FF000000"
                android:shadowDx="1.2"
                android:shadowDy="1.2"
                android:shadowRadius="2.0"
                android:singleLine="true"
                android:text="Title"
                android:textColor="#ffffffff"
                android:textSize="32.0px"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ScrollView
                android:id="@+id/dialog_text_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24.0px"
                android:layout_marginTop="20.0px"
                android:layout_marginEnd="10.0px"
                android:layout_marginBottom="16.0px"
                android:fadeScrollbars="true"
                android:scrollbars="none"
                android:visibility="visible"
                app:layout_constrainedHeight="true"
                app:layout_constraintBottom_toTopOf="@+id/dialog_input_layout"
                app:layout_constraintEnd_toStartOf="@+id/dialog_text_scrollbar"
                app:layout_constraintHeight_max="620.0px"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialog_caption"
                app:layout_constraintVertical_bias="0.0"
                app:layout_constraintWidth_max="940.0px"
                app:layout_constraintWidth_min="410.0px"
                app:layout_goneMarginBottom="20.0px"
                app:layout_goneMarginEnd="24.0px">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/dialog_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arial_bold"
                        android:lineSpacingExtra="4.0px"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1.2"
                        android:shadowDy="1.2"
                        android:shadowRadius="2.0"
                        android:text="Text"
                        android:textColor="#a9c4e4"
                        android:textSize="28.0px" />

                </LinearLayout>

            </ScrollView>

            <com.ryzn.game.gui.PcScrollbarView
                android:id="@+id/dialog_text_scrollbar"
                android:layout_width="28.0px"
                android:layout_height="0.0dip"
                android:layout_marginEnd="18.0px"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/dialog_text_layout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/dialog_text_layout" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dialog_input_layout"
                android:layout_width="0.0dip"
                android:layout_height="wrap_content"
                android:layout_marginStart="24.0px"
                android:layout_marginTop="4.0px"
                android:layout_marginEnd="24.0px"
                android:layout_marginBottom="20.0px"
                android:background="@drawable/samp_border"
                android:minHeight="74.0px"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@+id/dialog_buttons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialog_text_layout"
                app:layout_constraintWidth_min="420.0px">

                <EditText
                    android:id="@+id/dialog_input"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/arial"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:inputType="textShortMessage"
                    android:lines="1"
                    android:maxLines="1"
                    android:paddingStart="18.0px"
                    android:paddingTop="14.0px"
                    android:paddingEnd="18.0px"
                    android:paddingBottom="14.0px"
                    android:singleLine="true"
                    android:textColor="#ffffffff"
                    android:textColorHint="#7affffff"
                    android:textSize="30.0px"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dialog_list_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20.0px"
                android:layout_marginTop="16.0px"
                android:layout_marginEnd="20.0px"
                android:layout_marginBottom="16.0px"
                android:minWidth="580.0px"
                android:visibility="visible"
                app:layout_constraintBottom_toTopOf="@+id/dialog_buttons"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="620.0px"
                app:layout_constraintHeight_min="500.0px"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialog_caption">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dialog_tablist_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="14.0px"
                    android:paddingEnd="48.0px"
                    android:paddingBottom="10.0px"
                    android:visibility="visible"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/dialog_field1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arial_bold"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingEnd="20.0px"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1.2"
                        android:shadowDy="1.2"
                        android:shadowRadius="2.0"
                        android:singleLine="true"
                        android:text="Field1"
                        android:textColor="#a9c4e4"
                        android:textSize="30.0px"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/dialog_field2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arial_bold"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingEnd="20.0px"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1.2"
                        android:shadowDy="1.2"
                        android:shadowRadius="2.0"
                        android:singleLine="true"
                        android:text="Field2"
                        android:textColor="#a9c4e4"
                        android:textSize="30.0px"
                        app:layout_constraintStart_toEndOf="@+id/dialog_field1"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/dialog_field3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arial_bold"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingEnd="20.0px"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1.2"
                        android:shadowDy="1.2"
                        android:shadowRadius="2.0"
                        android:singleLine="true"
                        android:text="Field3"
                        android:textColor="#a9c4e4"
                        android:textSize="30.0px"
                        app:layout_constraintStart_toEndOf="@+id/dialog_field2"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/dialog_field4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arial_bold"
                        android:lines="1"
                        android:maxLines="1"
                        android:paddingEnd="20.0px"
                        android:shadowColor="#FF000000"
                        android:shadowDx="1.2"
                        android:shadowDy="1.2"
                        android:shadowRadius="2.0"
                        android:singleLine="true"
                        android:text="Field4"
                        android:textColor="#a9c4e4"
                        android:textSize="30.0px"
                        app:layout_constraintStart_toEndOf="@+id/dialog_field3"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/dialog_list"
                    android:layout_width="wrap_content"
                    android:layout_height="0.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/dialog_tablist_row">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/dialog_list_recycler"
                        android:layout_width="wrap_content"
                        android:layout_height="0.0dip"
                        android:layout_marginStart="8.0px"
                        android:layout_marginTop="8.0px"
                        android:layout_marginEnd="6.0px"
                        android:layout_marginBottom="8.0px"
                        android:scrollbars="none"
                        android:visibility="visible"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/dialog_list_scrollbar"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_goneMarginEnd="8.0px" />

                    <com.ryzn.game.gui.PcScrollbarView
                        android:id="@+id/dialog_list_scrollbar"
                        android:layout_width="28.0px"
                        android:layout_height="0.0dip"
                        android:layout_marginTop="6.0px"
                        android:layout_marginEnd="6.0px"
                        android:layout_marginBottom="6.0px"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/dialog_buttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24.0px"
                android:layout_marginEnd="24.0px"
                android:layout_marginBottom="20.0px"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialog_caption"
                app:layout_constraintVertical_bias="1.0">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_positive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/samp_border"
                    android:clickable="true"
                    android:focusable="true"
                    android:minWidth="160.0px"
                    android:minHeight="52.0px"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/button_positive_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32.0px"
                        android:layout_marginTop="10.0px"
                        android:layout_marginEnd="32.0px"
                        android:layout_marginBottom="10.0px"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/arial_bold"
                        android:lines="1"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="Button1"
                        android:textColor="#ffffffff"
                        android:textSize="30.0px"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/button_negative"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40.0px"
                    android:background="@drawable/samp_border"
                    android:clickable="true"
                    android:focusable="true"
                    android:minWidth="160.0px"
                    android:minHeight="52.0px"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/button_positive"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/button_negative_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32.0px"
                        android:layout_marginTop="10.0px"
                        android:layout_marginEnd="32.0px"
                        android:layout_marginBottom="10.0px"
                        android:duplicateParentState="true"
                        android:fontFamily="@font/arial_bold"
                        android:lines="1"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="Button2"
                        android:textColor="#ffffffff"
                        android:textSize="30.0px"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
