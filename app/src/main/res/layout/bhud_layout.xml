<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hud_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- Keep top-left native GTA radar (0%..19%) and top-right native GTA HUD (74%..100%) unobstructed -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_chat_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.19" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_chat_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.74" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_bp_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.39" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_voice_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.46" />

    <!-- Alyn-style translucent chat box -->
    <LinearLayout
        android:id="@+id/alyn_chat_box"
        android:layout_width="0dp"
        android:layout_height="@dimen/_92sdp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/alyn_chat_border"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="4dp"
        app:layout_constraintEnd_toStartOf="@id/guideline_chat_end"
        app:layout_constraintStart_toEndOf="@id/guideline_chat_start"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadeScrollbars="true"
            android:overScrollMode="never"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- Alyn-style collapsible quick keys bar (>>, ESC, TAB, ALT, SPC, F, H, 2, Y, N, C, G) -->
    <LinearLayout
        android:id="@+id/alyn_button_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_bp_top">

        <Button
            android:id="@+id/bp_extend"
            android:layout_width="34dp"
            android:layout_height="24dp"
            android:background="@drawable/alyn_button_bg"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="&gt;&gt;"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <HorizontalScrollView
            android:id="@+id/bp_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/bp_esc"
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="ESC"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_tab"
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="TAB"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_alt"
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="ALT"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_spc"
                    android:layout_width="34dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="SPC"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_f"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="F"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_h"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="H"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_2"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="2"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_y"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="Y"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_n"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="N"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_c"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="C"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/bp_g"
                    android:layout_width="28dp"
                    android:layout_height="24dp"
                    android:background="@drawable/alyn_button_bg"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:text="G"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Subtle Alyn-style mic button -->
    <ImageButton
        android:id="@+id/alyn_voice_btn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/_84sdp"
        android:background="@drawable/alyn_voice_bg"
        android:contentDescription="Voice"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/alyn_ic_voice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/guideline_voice_top" />

</androidx.constraintlayout.widget.ConstraintLayout>
