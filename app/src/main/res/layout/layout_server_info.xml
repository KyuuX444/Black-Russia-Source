<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ryzn_sheet_surface"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/server_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:maxLines="2"
        android:text="Memuat..."
        android:textColor="@color/manga_ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/server_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/montserrat_bold"
        android:gravity="center"
        android:maxLines="1"
        android:text="127.0.0.1:7777"
        android:textColor="@color/manga_crimson"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="9dp"
        android:layout_marginBottom="9dp"
        android:background="#CBD3E1" />

    <TextView
        android:id="@+id/server_players"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_medium"
        android:gravity="center"
        android:maxLines="1"
        android:text="Pemain: 0 / 0"
        android:textColor="@color/manga_ink"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/server_gamemode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:maxLines="1"
        android:text="Mode: SA-MP"
        android:textColor="@color/ryzn_text_secondary"
        android:textSize="10.5sp" />

    <TextView
        android:id="@+id/server_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:maxLines="1"
        android:text="Map: San Andreas"
        android:textColor="@color/ryzn_text_secondary"
        android:textSize="10.5sp" />

    <EditText
        android:id="@+id/nickname_input_text"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/ryzn_field_surface"
        android:fontFamily="@font/montserrat_medium"
        android:hint="Nick_Name..."
        android:imeOptions="actionDone"
        android:inputType="textNoSuggestions"
        android:maxLength="24"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/manga_ink"
        android:textColorHint="@color/ryzn_text_muted"
        android:textSize="11.5sp" />

    <EditText
        android:id="@+id/password_input_text"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ryzn_field_surface"
        android:fontFamily="@font/montserrat_medium"
        android:hint="Kata sandi server..."
        android:imeOptions="actionDone"
        android:inputType="textPassword"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/manga_ink"
        android:textColorHint="@color/ryzn_text_muted"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/delete_button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_action_dark"
            android:drawableStart="@drawable/ic_delete"
            android:drawablePadding="5dp"
            android:fontFamily="@font/montserrat_bold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="1dp"
            android:text="Hapus"
            android:textAllCaps="false"
            android:textColor="@color/manga_ink"
            android:textSize="11.5sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/connect_button"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_play_purple"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="5dp"
            android:fontFamily="@font/montserrat_bold"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="2dp"
            android:text="Hubungkan"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
