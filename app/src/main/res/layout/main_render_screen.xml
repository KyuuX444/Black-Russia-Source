<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_fl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="bottom">

    <SurfaceView
        android:id="@+id/main_sv"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/ui_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/main_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#DD121212"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp">

            <com.nvidia.devtech.CustomEditText
                android:id="@+id/main_et_input"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/alyn_input_bg"
                android:hint="Ketik pesan atau /perintah..."
                android:imeOptions="actionSend|flagNoExtractUi|flagNoFullscreen"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8A8A"
                android:textSize="13sp" />

            <Button
                android:id="@+id/main_but_input_prev"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/alyn_btn_secondary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="&#x22C1;"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/main_but_input_next"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/alyn_btn_secondary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="&#x22C0;"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/main_but_input_slash"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/alyn_btn_secondary"
                android:gravity="center"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="/"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:id="@+id/dark_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.0"
            android:background="#ff000000"
            android:visibility="visible" />

        <include layout="@layout/bhud_layout" />
        <include layout="@layout/window_dialog" />
        <include layout="@layout/hassle_tab" />
        <include layout="@layout/br_serverselect" />
    </FrameLayout>
</FrameLayout>
