<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_fl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="bottom">

    <SurfaceView
        android:id="@+id/main_sv"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/ui_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <!-- SA-MP Keyboard input bar -->
        <LinearLayout
            android:id="@+id/main_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="@dimen/_2sdp"
            android:background="@drawable/samp_border"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/_5sdp"
            android:paddingRight="@dimen/_5sdp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/main_but_input_slash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/ic_slash"
                android:contentDescription="/"
                android:minWidth="@dimen/_10sdp"
                android:minHeight="@dimen/_10sdp" />

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:background="#ffffff" />

            <ImageButton
                android:id="@+id/main_but_input_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/ic_arrow_up"
                android:contentDescription="Prev"
                android:minWidth="@dimen/_10sdp"
                android:minHeight="@dimen/_10sdp" />

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:background="#ffffff" />

            <ImageButton
                android:id="@+id/main_but_input_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:background="@drawable/ic_arrow_down"
                android:contentDescription="Next"
                android:minWidth="@dimen/_10sdp"
                android:minHeight="@dimen/_10sdp" />

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:background="#ffffff" />

            <com.nvidia.devtech.CustomEditText
                android:id="@+id/main_et_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_weight="0.7"
                android:background="@android:color/transparent"
                android:ems="10"
                android:hint="Ketik pesan atau /perintah..."
                android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                android:inputType="text"
                android:paddingTop="@dimen/_4sdp"
                android:paddingBottom="@dimen/_4sdp"
                android:singleLine="true"
                android:textColor="#FFFFFF"
                android:textColorHint="#8A8A8A"
                android:textSize="12sp" />

            <View
                android:layout_width="@dimen/_1sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_3sdp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:background="#ffffff" />

            <ImageButton
                android:id="@+id/main_but_input_ok"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:background="@drawable/ic_send"
                android:contentDescription="Kirim"
                android:minWidth="@dimen/_10sdp"
                android:minHeight="@dimen/_10sdp" />
        </LinearLayout>

        <View
            android:id="@+id/dark_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.0"
            android:background="#ff000000"
            android:visibility="visible" />

        <include layout="@layout/bhud_layout" />
        <include layout="@layout/window_dialog" />
        <include layout="@layout/hassle_tab" />
        <include layout="@layout/br_serverselect" />
    </FrameLayout>
</FrameLayout>
