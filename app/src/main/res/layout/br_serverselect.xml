<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/br_serverselect_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Alyn-style clean loading screen -->
    <LinearLayout
        android:id="@+id/choose_server_root_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_br"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="Ryzn SA-MP"
                android:textColor="@color/white"
                android:textSize="38sp"
                app:layout_constraintBottom_toTopOf="@id/tv_play_black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_play_black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:fontFamily="@font/montserrat_regular"
                android:text="Memuat game dan klien SA-MP 0.3.7..."
                android:textColor="#9E9E9E"
                android:textSize="12sp"
                app:layout_constraintBottom_toTopOf="@id/loading_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/iv_smile"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/loading_text"
                style="@style/MontserratRegular14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Sedang memuat..."
                android:textColor="@color/white"
                app:layout_constraintBottom_toTopOf="@+id/progress_bar"
                app:layout_constraintStart_toStartOf="@+id/progress_bar" />

            <TextView
                android:id="@+id/loading_percent"
                style="@style/MontserratRegular14sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textColor="#9ECAFF"
                app:layout_constraintBottom_toTopOf="@+id/progress_bar"
                app:layout_constraintEnd_toEndOf="@+id/progress_bar" />

            <com.akexorcist.roundcornerprogressbar.RoundCornerProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_5sdp"
                android:layout_marginStart="90dp"
                android:layout_marginEnd="90dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.64"
                app:rcBackgroundColor="#25FFFFFF"
                app:rcBackgroundPadding="0dp"
                app:rcMax="100.0"
                app:rcProgress="0.0"
                app:rcProgressColor="#1E88E5"
                app:rcRadius="@dimen/_3sdp"
                app:rcReverse="false"
                app:rcSecondaryProgress="0.0"
                app:rcSecondaryProgressColor="#64B5F6" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- Alyn-style clean Direct Connect / Server Select screen -->
    <LinearLayout
        android:id="@+id/choose_server_root_choose"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:orientation="vertical"
        android:paddingLeft="32dp"
        android:paddingTop="18dp"
        android:paddingRight="32dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:text="Pilih Server SA-MP"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <Button
                android:id="@+id/servers_btn_my_server"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/alyn_btn_primary"
                android:fontFamily="@font/montserrat_bold"
                android:minWidth="130dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Sambung Langsung"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/all_servers_button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/alyn_btn_secondary"
                android:fontFamily="@font/montserrat_bold"
                android:minWidth="110dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Daftar Server"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="#2A2A2A" />

        <ScrollView
            android:id="@+id/main_servers_choose"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="14dp">

                <FrameLayout
                    android:id="@+id/server_main_frame"
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/alyn_card_bg"
                    android:padding="14dp">

                    <View
                        android:id="@+id/server_list_back_color"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/br_server_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserrat_bold"
                            android:text="Server Bebas (SA-MP 0.3.7)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp" />

                        <com.akexorcist.roundcornerprogressbar.RoundCornerProgressBar
                            android:id="@+id/br_server_progress"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_6sdp"
                            android:layout_marginTop="8dp"
                            app:rcBackgroundColor="#25FFFFFF"
                            app:rcBackgroundPadding="0dp"
                            app:rcMax="100"
                            app:rcProgress="100"
                            app:rcProgressColor="#1E88E5"
                            app:rcRadius="@dimen/_3sdp"
                            app:rcReverse="false"
                            app:rcSecondaryProgress="0"
                            app:rcSecondaryProgressColor="#64B5F6" />

                        <TextView
                            android:id="@+id/br_server_online"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/montserrat_regular"
                            android:text="Masukkan IP:Port server di bawah"
                            android:textColor="#B8B8B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/br_server_image"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/br_server_ip_input"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/alyn_input_bg"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="center_vertical"
                        android:hint="IP:Port server (cth. 127.0.0.1:7777)"
                        android:imeOptions="actionDone|flagNoFullscreen"
                        android:inputType="textUri|textNoSuggestions"
                        android:maxLength="127"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8A8A8A"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/br_server_pass_input"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/alyn_input_bg"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="center_vertical"
                        android:hint="Password server (kosongkan jika tidak ada)"
                        android:imeOptions="actionDone|flagNoFullscreen"
                        android:inputType="textPassword"
                        android:maxLength="127"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#8A8A8A"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/br_servers_play"
                    android:layout_width="220dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/alyn_btn_primary"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Main"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/list_servers_choose"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/scroll_layout_servers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingEnd="10dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
