<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/br_serverselect_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/choose_server_root_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#121212"
        android:padding="24dp">

        <ImageView
            android:id="@+id/iv_loading_logo"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/logo_splash"
            app:layout_constraintBottom_toTopOf="@id/tv_br"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.42"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_br"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Ryzn SA-MP"
            android:textColor="@color/white"
            android:textSize="26sp"
            app:layout_constraintBottom_toTopOf="@id/tv_play_black"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_loading_logo" />

        <TextView
            android:id="@+id/tv_play_black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Memuat GTA: San Andreas &amp; SA-MP 0.3.7..."
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/loading_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_br" />

        <TextView
            android:id="@+id/loading_text"
            style="@style/MontserratRegular14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Sedang memuat..."
            android:textColor="@color/white"
            app:layout_constraintBottom_toTopOf="@+id/progress_bar"
            app:layout_constraintStart_toStartOf="@+id/progress_bar" />

        <TextView
            android:id="@+id/loading_percent"
            style="@style/MontserratRegular14sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="0%"
            android:textColor="@color/ryzn_accent"
            app:layout_constraintBottom_toTopOf="@+id/progress_bar"
            app:layout_constraintEnd_toEndOf="@+id/progress_bar" />

        <com.akexorcist.roundcornerprogressbar.RoundCornerProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_5sdp"
            android:layout_marginStart="90dp"
            android:layout_marginEnd="90dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.72"
            app:rcBackgroundColor="#25FFFFFF"
            app:rcBackgroundPadding="0dp"
            app:rcMax="100.0"
            app:rcProgress="0.0"
            app:rcProgressColor="@color/ryzn_accent"
            app:rcRadius="@dimen/_3sdp"
            app:rcReverse="false"
            app:rcSecondaryProgress="0.0"
            app:rcSecondaryProgressColor="#9ECAFF" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
