<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="12.0px">

    <ImageView
        android:id="@+id/item_bg"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:background="#40808080"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_field1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_4sdp"
        android:fontFamily="@font/arial_bold"
        android:lines="1"
        android:maxLines="1"
        android:paddingTop="@dimen/_4sdp"
        android:paddingEnd="@dimen/_5sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:shadowColor="#FF000000"
        android:shadowDx="1.2"
        android:shadowDy="1.2"
        android:shadowRadius="2.0"
        android:singleLine="true"
        android:text="Field1"
        android:textColor="#ffffffff"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_field2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arial_bold"
        android:lines="1"
        android:maxLines="1"
        android:paddingTop="@dimen/_4sdp"
        android:paddingEnd="@dimen/_5sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:shadowColor="#FF000000"
        android:shadowDx="1.2"
        android:shadowDy="1.2"
        android:shadowRadius="2.0"
        android:singleLine="true"
        android:text="Field2"
        android:textColor="#ffffffff"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintStart_toEndOf="@+id/item_field1"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_field3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arial_bold"
        android:lines="1"
        android:maxLines="1"
        android:paddingTop="@dimen/_4sdp"
        android:paddingEnd="@dimen/_5sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:shadowColor="#FF000000"
        android:shadowDx="1.2"
        android:shadowDy="1.2"
        android:shadowRadius="2.0"
        android:singleLine="true"
        android:text="Field3"
        android:textColor="#ffffffff"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintStart_toEndOf="@+id/item_field2"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/item_field4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arial_bold"
        android:lines="1"
        android:maxLines="1"
        android:paddingTop="@dimen/_4sdp"
        android:paddingEnd="@dimen/_5sdp"
        android:paddingBottom="@dimen/_4sdp"
        android:shadowColor="#FF000000"
        android:shadowDx="1.2"
        android:shadowDy="1.2"
        android:shadowRadius="2.0"
        android:singleLine="true"
        android:text="Field4"
        android:textColor="#ffffffff"
        android:textSize="@dimen/_8sdp"
        app:layout_constraintStart_toEndOf="@+id/item_field3"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
