<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#5420AD"
                android:startColor="#682BD0" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1.5dp"
                android:color="#C4B5FD" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#682BD0"
                android:startColor="#803DF2" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1.5dp"
                android:color="#A78BFA" />
        </shape>
    </item>
</selector>
