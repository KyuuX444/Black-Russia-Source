<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4F46E5" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1.8dp"
                        android:color="#18181B" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:left="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#18181B" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#4F46E5" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="2dp"
                        android:color="#06B6D4" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_hovered="true">
        <layer-list>
            <item android:left="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#18181B" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#5B5EF0" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1.8dp"
                        android:color="#18181B" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="2dp" android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#18181B" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6366F1" />
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="1.8dp"
                        android:color="#18181B" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
