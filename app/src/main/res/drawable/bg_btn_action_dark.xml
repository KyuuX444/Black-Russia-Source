<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="1.5dp" android:top="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#EAEFF8" />
                    <corners android:radius="6dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#151824" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="1.5dp" android:top="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#151824" />
                    <corners android:radius="6dp" />
                </shape>
            </item>
            <item android:bottom="1.5dp" android:right="1.5dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="6dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#151824" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
